# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nb_transcribe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Antall forsøk og ventetid (sekunder) ved oppkobling mot databasen under oppstart
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY=2

# Sett til 1 for å inkludere full traceback i /jobs/{id}-feilresponser (kun for lokal debugging)
EXPOSE_ERROR_DETAILS=0

# Model Configuration
MODEL_ID=nb-whisper-large
# Optional Hugging Face token if the model requires authentication
HF_TOKEN=
