# Frontend environment variables
# Set NEXT_PUBLIC_MOCK_MODE=1 to enable the mock UI without a backend.
NEXT_PUBLIC_MOCK_MODE=1
# Base URL for the FastAPI backend when not running in mock mode.
# `BACKEND_URL` is preferred for server-side proxying; `NEXT_PUBLIC_BACKEND_URL`
# works as a fallback when only the public variable is available.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
