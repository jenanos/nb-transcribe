# Frontend environment variables
# Set NEXT_PUBLIC_MOCK_MODE=1 (or TRANSCRIBE_MOCK_MODE=1) to enable the mock UI without a backend.
NEXT_PUBLIC_MOCK_MODE=1
#TRANSCRIBE_MOCK_MODE=1
# Base URL for the FastAPI backend when not running in mock mode.
# `BACKEND_URL` is preferred for server-side proxying; `NEXT_PUBLIC_BACKEND_URL` or
# `NEXT_PUBLIC_API_URL` work as fallbacks when only the public variable is available.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
#NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Cloudflare Access service tokens for talking to BACKEND_URL securely.
# Never prefix these with NEXT_PUBLIC_.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
