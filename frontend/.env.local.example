# Frontend environment variables
# Base URL for the FastAPI backend.
# `BACKEND_URL` is preferred for server-side proxying; `NEXT_PUBLIC_BACKEND_URL` or
# `NEXT_PUBLIC_API_URL` work as fallbacks when only the public variable is available.
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
#NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional: bypass the Next.js proxy and stream uploads directly to the backend.
# Useful for very large files (10+ minutes) that would otherwise hit the proxy limit.
#NEXT_PUBLIC_DIRECT_BACKEND_URL=http://127.0.0.1:8000
# NOTE: When pointing the browser at a direct backend URL, ensure the backend's CORS
# allow_origins includes the domain that serves this frontend.
# Cloudflare Access service tokens for talking to BACKEND_URL securely.
# Never prefix these with NEXT_PUBLIC_.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
